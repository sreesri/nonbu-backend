# Copy to .env for local development.

# Local SQLite (default) or Neon/Postgres: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./nonbu.db

# At least 32 characters. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Google OAuth Web client ID(s) — the audience of the ID tokens the app sends.
GOOGLE_CLIENT_IDS=xxxxxxxx.apps.googleusercontent.com

# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=you@gmail.com

# Optional
# ACCESS_TOKEN_MINUTES=60
# REFRESH_TOKEN_DAYS=60
